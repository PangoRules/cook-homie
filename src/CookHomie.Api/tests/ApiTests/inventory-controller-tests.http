### Get All Inventory Items

GET http://localhost:5000/api/inventory HTTP/1.1
Accept: application/json

> {%
  client.test("Returns 200 OK", function() {
    client.assert(response.status === 200, "Expected 200 OK");
  });
%}


### Create Inventory Item

POST http://localhost:5000/api/inventory HTTP/1.1
Content-Type: application/json

{
  "Category": "Test Category",
  "IsOpened": false,
  "Location": "Fridge",
  "Name": "Testing Item",
  "Quantity": 1,
  "Unit": "unit"
}

> {%
  client.test("Returns 201 Created", function() {
    client.assert(response.status === 201, "Expected 201 Created");
  });
  client.test("Response body contains created item id", function() {
    client.assert(response.body["id"] != null, "Expected response body to contain an id");
  });
%}


### Missing Name Validation

POST http://localhost:5000/api/inventory HTTP/1.1
Content-Type: application/json

{
  "Category": "Test Category",
  "IsOpened": false,
  "Location": "Fridge",
  "Name": "",
  "Quantity": 1,
  "Unit": "unit"
}

> {%
  client.test("Returns 400 for missing name", function() {
    client.assert(response.status === 400, "Expected 400 Bad Request");
  });
  client.test("Body contains validation message", function() {
    client.assert(response.body["detail"].includes("Name is required"), "Expected 'Name is required' in response");
  });
%}
